# AEGIS Protocol Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Backend API Configuration
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8000
AEGIS_LOG_LEVEL=info
AEGIS_CORS_ORIGINS=*

# Blockchain & Oracle Configuration (EVM Testnet / Hardhat)
RPC_URL=http://127.0.0.1:8545
ORACLE_NODE_ADDRESS=0x89205A3A3b2A69De6Dbf7f01ED13B2108B2c43e7
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Machine Learning Paths
MODEL_PATH=ml/models/best_calibrated_model.joblib
PREPROCESSOR_PATH=ml/models/preprocessor.joblib
