# Data Directory Rules (Hackathon Cleanliness)
# Ignore ALL raw data files (including the 1.09 GB XPT file)
data/raw/*

# Ignore large binary parquet files in processed (keep CSV sample & JSON metadata)
data/processed/*.parquet

# Ignore large non-production model binaries (>25MB)
ml/models/random_forest.joblib

